# Copy to `.env.local` (local dev) or set these in Vercel project settings.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel cron authentication (required so cron endpoints can't be triggered publicly)
CRON_SECRET=

# Weekly AI insights (OpenCode Go — OpenAI-compatible chat completions)
# LLM_API_URL must be the full /chat/completions endpoint.
# Valid chat-completions model IDs include: deepseek-v4-flash, deepseek-v4-pro,
# glm-5.3-flash, kimi-k2.6, longcat-2.0, hy3. Use a cheap one for this task.
LLM_API_URL=https://opencode.ai/zen/go/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
